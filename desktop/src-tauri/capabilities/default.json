{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-shell",
  "description": "Local main shell with scoped Copilot commands, pure editor planning, and explicit browser/media/workspace placeholders; no generic filesystem, shell execution, or remote webview permissions.",
  "windows": ["main"],
  "permissions": [
    "allow-shell-status",
    "allow-internal-browser-capabilities",
    "allow-internal-browser-purge",
    "allow-editor-capabilities",
    "allow-editor-trim-plan",
    "allow-editor-run-trim",
    "allow-editor-process-image",
    "allow-copilot-status",
    "allow-copilot-models",
    "allow-copilot-chat",
    "allow-copilot-cancel",
    "allow-media-library",
    "allow-media-import",
    "allow-media-set-favorite",
    "allow-media-remove",
    "allow-media-playback-source",
    "allow-media-enqueue-download",
    "allow-media-download-jobs",
    "allow-media-run-download-demo",
    "allow-media-cancel-download",
    "allow-workspace-snapshot",
    "allow-workspace-create-note",
    "allow-workspace-save-note",
    "allow-workspace-delete-note",
    "allow-workspace-create-sheet",
    "allow-workspace-save-sheet",
    "allow-workspace-delete-sheet"
  ]
}
